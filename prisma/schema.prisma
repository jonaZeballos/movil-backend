// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Negocio {
  id            String   @id @map("id_negocio") @db.VarChar(1000)
  nombre        String   @db.VarChar(200)
  emailContacto String?  @map("email_contacto") @db.VarChar(200)
  telefono      String?  @db.VarChar(30)
  direccion     String?  @db.VarChar(300)
  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Date

  usuarios       Usuario[]
  clientes       Cliente[]
  equipos        Equipo[]
  ordenes        OrdenServicio[]
  productos      Producto[]
  categoriasProducto CategoriaProducto[]
  cotizaciones   Cotizacion[]
  ventas         Venta[]
  notificaciones Notificacion[]

  @@map("negocio")
}

model Rol {
  id       String    @id @map("id_rol") @db.VarChar(1000)
  rol      String    @db.VarChar(200)
  usuarios Usuario[]

  @@unique([rol])
  @@map("roles")
}

model Usuario {
  id            String   @id @map("id_usuario") @db.VarChar(1000)
  nombres       String   @db.VarChar(100)
  apellidos     String   @db.VarChar(100)
  username      String   @db.VarChar(30)
  email         String   @db.VarChar(200)
  password      String   @db.VarChar(1024)
  fechaCreacion DateTime @map("fecha_creacion") @db.Date
  bloqueado     Boolean  @default(false)
  motivoBloqueo String?  @map("motivo_bloqueo") @db.VarChar(300)
  fechaBloqueo  DateTime? @map("fecha_bloqueo") @db.Date

  idRol String? @map("id_rol") @db.VarChar(1000)
  rol   Rol?    @relation(fields: [idRol], references: [id])

  idNegocio String  @map("id_negocio") @db.VarChar(1000)
  negocio   Negocio @relation(fields: [idNegocio], references: [id])

  cliente   Cliente?
  telefonos Telefono[]
  ordenes   OrdenServicio[]
  productosTecnico Producto[] @relation("ProductoTecnico")

  @@unique([username])
  @@unique([email])
  @@index([idNegocio])
  @@map("usuario")
}

model Cliente {
  idUsuario       String  @id @map("id_usuario") @db.VarChar(1000)
  razonSocial     String  @map("razon_social") @db.VarChar(100)
  numeroDocumento BigInt  @map("numero_documento") @db.BigInt
  email           String? @db.VarChar(200)
  direccion       String? @db.VarChar(300)
  enListaNegra    Boolean @default(false) @map("en_lista_negra")
  motivoListaNegra String? @map("motivo_lista_negra") @db.VarChar(300)
  fechaListaNegra DateTime? @map("fecha_lista_negra") @db.Date

  usuario   Usuario  @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  idNegocio String   @map("id_negocio") @db.VarChar(1000)
  negocio   Negocio  @relation(fields: [idNegocio], references: [id])
  equipos   Equipo[]
  ventas    Venta[]

  @@unique([idNegocio, numeroDocumento])
  @@index([idNegocio])
  @@map("cliente")
}

model Telefono {
  id     String @id @map("id_telefono") @db.VarChar(1000)
  numero BigInt @db.BigInt

  idUsuario String  @map("id_usuario") @db.VarChar(1000)
  usuario   Usuario @relation(fields: [idUsuario], references: [id])

  @@map("telefono")
}

model TipoEquipo {
  id      String   @id @map("id_tipo_equipo") @db.VarChar(1000)
  nombre  String   @map("nombre_tipo") @db.VarChar(200)
  equipos Equipo[]

  @@map("tipo_equipo")
}

model Marca {
  id      String   @id @map("id_marca") @db.VarChar(1000)
  nombre  String   @map("nombre_marca") @db.VarChar(1024)
  modelos Modelo[]

  @@map("marca")
}

model Modelo {
  id              String   @id @map("id_modelo") @db.VarChar(1000)
  nombreModelo    String   @map("nombre_modelo") @db.VarChar(100)
  nombreComercial String   @map("nombre_comercial") @db.VarChar(100)
  lanzamiento     DateTime @db.Date

  idMarca String @map("id_marca") @db.VarChar(1000)
  marca   Marca  @relation(fields: [idMarca], references: [id])

  equipos Equipo[]

  @@map("modelo")
}

model Equipo {
  id            String   @id @map("id_equipo") @db.VarChar(1000)
  nroSerie      String   @map("nro_serie") @db.VarChar(200)
  fechaRegistro DateTime @map("fecha_registro") @db.Date
  activo        Boolean  @default(true)
  motivoBaja    String?  @map("motivo_baja") @db.VarChar(300)
  fechaBaja     DateTime? @map("fecha_baja") @db.Date

  idCliente    String @map("id_cliente") @db.VarChar(1000)
  idTipoEquipo String @map("id_tipo_equipo") @db.VarChar(1000)
  idModelo     String @map("id_modelo") @db.VarChar(1000)
  idNegocio    String @map("id_negocio") @db.VarChar(1000)

  cliente    Cliente         @relation(fields: [idCliente], references: [idUsuario])
  tipoEquipo TipoEquipo      @relation(fields: [idTipoEquipo], references: [id])
  modelo     Modelo          @relation(fields: [idModelo], references: [id])
  negocio    Negocio         @relation(fields: [idNegocio], references: [id])
  ordenes    OrdenServicio[]

  @@index([idNegocio])
  @@map("equipo")
}

model EstadoOrdenServicio {
  id      String          @id @map("id_estado_orden_pago") @db.VarChar(1000)
  nombre  String          @map("nombre_estado_ops") @db.VarChar(20)
  ordenes OrdenServicio[]

  @@unique([nombre])
  @@map("estado_orden_servicio")
}

model Prioridad {
  id        String          @id @map("id_prioridad") @db.VarChar(1000)
  prioridad String          @db.VarChar(100)
  ordenes   OrdenServicio[]

  @@unique([prioridad])
  @@map("prioridad")
}

model OrdenServicio {
  id             String    @id @map("id_orden_servicio") @db.VarChar(1000)
  codigo         Int
  fechaRecepcion DateTime  @map("fecha_recepcion") @db.Date
  fechaEntrega   DateTime? @map("fecha_entrega") @db.Date
  diagnostico    String    @db.VarChar(400)
  garantiaDias   Int       @map("garantia_dias")
  observaciones  String?   @db.VarChar(1024)

  idEquipo    String  @map("id_equipo") @db.VarChar(1000)
  idTecnico   String? @map("id_usuario") @db.VarChar(1000)
  idEstado    String  @map("id_estado_orden_pago") @db.VarChar(1000)
  idPrioridad String  @map("id_prioridad") @db.VarChar(1000)
  idNegocio   String  @map("id_negocio") @db.VarChar(1000)

  equipo       Equipo              @relation(fields: [idEquipo], references: [id])
  tecnico      Usuario?            @relation(fields: [idTecnico], references: [id])
  estado       EstadoOrdenServicio @relation(fields: [idEstado], references: [id])
  prioridad    Prioridad           @relation(fields: [idPrioridad], references: [id])
  negocio      Negocio             @relation(fields: [idNegocio], references: [id])
  cotizaciones Cotizacion[]
  cotizacionLinks CotizacionOrden[]

  @@unique([idNegocio, codigo])
  @@index([idNegocio])
  @@map("orden_servicio")
}

model Producto {
  id            String   @id @map("id_producto") @db.VarChar(1000)
  nombre        String   @db.VarChar(200)
  marca         String?  @db.VarChar(100)
  modelo        String?  @db.VarChar(100)
  descripcion   String?  @db.VarChar(500)
  precio        Decimal  @db.Decimal(10, 2)
  stock         Int
  stockMinimo   Int      @default(1) @map("stock_minimo")
  tipoInventario String  @default("tienda") @map("tipo_inventario") @db.VarChar(20)
  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Date
  activo        Boolean  @default(true)
  motivoDesactivacion String? @map("motivo_desactivacion") @db.VarChar(300)
  fechaDesactivacion DateTime? @map("fecha_desactivacion") @db.Date

  idNegocio     String         @map("id_negocio") @db.VarChar(1000)
  idCategoria   String?        @map("id_categoria") @db.VarChar(1000)
  idTecnico     String?        @map("id_tecnico") @db.VarChar(1000)
  negocio       Negocio        @relation(fields: [idNegocio], references: [id])
  categoria     CategoriaProducto? @relation(fields: [idCategoria], references: [id])
  tecnico       Usuario?       @relation("ProductoTecnico", fields: [idTecnico], references: [id])
  detallesVenta VentaDetalle[]

  @@index([idNegocio])
  @@index([idCategoria])
  @@index([idTecnico])
  @@index([tipoInventario])
  @@map("producto")
}

model CategoriaProducto {
  id            String   @id @map("id_categoria") @db.VarChar(1000)
  nombre        String   @db.VarChar(100)
  descripcion   String?  @db.VarChar(300)
  tipoInventario String  @default("tienda") @map("tipo_inventario") @db.VarChar(20)
  activa        Boolean  @default(true)
  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Date

  idNegocio String    @map("id_negocio") @db.VarChar(1000)
  negocio   Negocio   @relation(fields: [idNegocio], references: [id])
  productos Producto[]

  @@unique([idNegocio, tipoInventario, nombre])
  @@index([idNegocio])
  @@index([tipoInventario])
  @@map("categoria_producto")
}

model Cotizacion {
  id            String   @id @map("id_cotizacion") @db.VarChar(1000)
  numero        Int
  descripcion   String   @db.VarChar(500)
  manoObra      Decimal  @map("mano_obra") @db.Decimal(10, 2)
  repuestos     Decimal  @db.Decimal(10, 2)
  descuento     Decimal  @default(0) @db.Decimal(10, 2)
  total         Decimal  @db.Decimal(10, 2)
  observaciones String?  @db.VarChar(1024)
  estado        String   @default("Pendiente") @db.VarChar(50)
  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Date

  idOrden   String        @map("id_orden_servicio") @db.VarChar(1000)
  orden     OrdenServicio @relation(fields: [idOrden], references: [id])
  idNegocio String        @map("id_negocio") @db.VarChar(1000)
  negocio   Negocio       @relation(fields: [idNegocio], references: [id])
  ordenLinks CotizacionOrden[]

  @@unique([idNegocio, numero])
  @@index([idNegocio])
  @@map("cotizacion")
}

model CotizacionOrden {
  id           String @id @map("id_cotizacion_orden") @db.VarChar(1000)
  idCotizacion String @map("id_cotizacion") @db.VarChar(1000)
  idOrden      String @map("id_orden_servicio") @db.VarChar(1000)

  cotizacion Cotizacion     @relation(fields: [idCotizacion], references: [id], onDelete: Cascade)
  orden      OrdenServicio  @relation(fields: [idOrden], references: [id])

  @@unique([idCotizacion, idOrden])
  @@index([idOrden])
  @@map("cotizacion_orden")
}

model Venta {
  id            String   @id @map("id_venta") @db.VarChar(1000)
  numero        Int
  clienteNombre String?  @map("cliente_nombre") @db.VarChar(200)
  total         Decimal  @db.Decimal(10, 2)
  reciboCodigo  String   @map("recibo_codigo") @db.VarChar(50)
  fechaCreacion DateTime @default(now()) @map("fecha_creacion") @db.Date

  idCliente String?        @map("id_cliente") @db.VarChar(1000)
  cliente   Cliente?       @relation(fields: [idCliente], references: [idUsuario])
  idNegocio String         @map("id_negocio") @db.VarChar(1000)
  negocio   Negocio        @relation(fields: [idNegocio], references: [id])
  detalles  VentaDetalle[]

  @@unique([idNegocio, numero])
  @@unique([idNegocio, reciboCodigo])
  @@index([idNegocio])
  @@map("venta")
}

model VentaDetalle {
  id             String  @id @map("id_venta_detalle") @db.VarChar(1000)
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)

  idVenta    String @map("id_venta") @db.VarChar(1000)
  idProducto String @map("id_producto") @db.VarChar(1000)

  venta    Venta    @relation(fields: [idVenta], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [idProducto], references: [id])

  @@map("venta_detalle")
}

model Notificacion {
  id             String   @id @map("id_notificacion") @db.VarChar(1000)
  tipo           String   @db.VarChar(50)
  titulo         String   @db.VarChar(200)
  mensaje        String   @db.VarChar(1024)
  leida          Boolean  @default(false)
  referenciaId   String?  @map("referencia_id") @db.VarChar(1000)
  referenciaTipo String?  @map("referencia_tipo") @db.VarChar(50)
  fechaCreacion  DateTime @default(now()) @map("fecha_creacion") @db.Date
  idNegocio      String   @map("id_negocio") @db.VarChar(1000)
  negocio        Negocio  @relation(fields: [idNegocio], references: [id])

  @@index([idNegocio])
  @@map("notificacion")
}
